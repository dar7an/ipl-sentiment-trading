# Optional. Core CLI and Streamlit work fully offline without these.

# Gemini Developer API (google-genai). Either name is accepted.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Default hosted narrative model (only used with --narrative / UI toggle).
NARRATIVE_MODEL=gemini-3.5-flash-lite

# Local Gemma 4 (or any OpenAI-compatible chat completions endpoint).
# When set, narrative uses this instead of Gemini.
# Example: http://127.0.0.1:8080/v1
NARRATIVE_BASE_URL=
NARRATIVE_API_KEY=

# Override corpus location (defaults to <repo>/data).
# IPL_DATA_DIR=
