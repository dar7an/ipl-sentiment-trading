# All optional. The CLI and UI run fully offline (VADER baseline) with no env.

# Jev decision API — official TypeSafe endpoint https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
# Metered proxy alternative (jv_live_...); sets base URL automatically.
# JEV_API_KEY=
# JEV_BASE_URL=
# JEV_MODEL=jev-latest

# Gemma 4 narrator — Gemini Developer API (google-genai). Either name works.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Narrator model ids. Jev routes between them by interval drama.
NARRATIVE_MODEL=gemma-4-26b-a4b-it
NARRATIVE_MODEL_PRO=gemma-4-31b-it

# Local Gemma 4 (any OpenAI-compatible chat endpoint) — used instead of Gemini.
# NARRATIVE_BASE_URL=http://127.0.0.1:8080/v1
# NARRATIVE_API_KEY=

# Override corpus location (defaults to <repo>/data).
# IPL_DATA_DIR=
